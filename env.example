# Salin file ini menjadi ".env" lalu isi kuncinya. Jangan di-upload ke GitHub.

# --- Opsi 1: Groq (cepat, ada kuota gratis) ---
LLM_API_KEY=isi_api_key_anda
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Opsi 2: Gemini (endpoint OpenAI-compatible) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# --- Opsi 3: Ollama lokal ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

# --- Konfigurasi Modul Agent (Tool Calling) ---
# 1 = aktif (default), 0 = nonaktif
AGENT_ENABLED=1
# "keyword" = hemat biaya, hanya aktif saat ada kata kunci aksi (default)
# "always"  = agent selalu dipanggil di setiap giliran
AGENT_TRIGGER_MODE=keyword

# Nama model sering berganti; cek daftar model terbaru di dashboard penyedia.

# --- Konfigurasi TTS (Text-to-Speech) ---
# Backend TTS: "edge" (Edge-TTS bawaan), "sbv2" (Style-Bert-VITS2 lokal), atau "auto" (prioritas SBV2, fallback ke Edge)
TTS_BACKEND=auto
# Perangkat inferensi SBV2: "auto", "cuda", atau "cpu"
SBV2_DEVICE=auto
# Batas waktu sintesis per kalimat untuk SBV2 dalam detik (bila lewat, jatuh ke Edge pada mode auto)
SBV2_TIMEOUT_S=4.0

