# Salin file ini menjadi ".env" lalu isi kuncinya. Jangan di-upload ke GitHub.

# --- Opsi 1: Groq (cepat, ada kuota gratis) ---
LLM_API_KEY=isi_api_key_anda
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Opsi 2: Gemini (endpoint OpenAI-compatible) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# --- Opsi 3: Ollama lokal ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

# --- Konfigurasi Modul Agent (Tool Calling) ---
# 1 = aktif (default), 0 = nonaktif
AGENT_ENABLED=1
# "keyword" = hemat biaya, hanya aktif saat ada kata kunci aksi (default)
# "always"  = agent selalu dipanggil di setiap giliran
AGENT_TRIGGER_MODE=keyword

# Nama model sering berganti; cek daftar model terbaru di dashboard penyedia.

# --- Konfigurasi TTS (Text-to-Speech) ---
# Backend TTS: "edge" (Edge-TTS bawaan), "sbv2" (Style-Bert-VITS2 lokal), atau "auto"
# Mode "sbv2"  = SBV2 selalu dipakai (default); tidak ada fallback ke Edge
# Mode "auto"  = SBV2 utama, fallback ke Edge hanya untuk kegagalan nyata (exception/OOM)
# Mode "edge"  = Edge-TTS saja
TTS_BACKEND=sbv2
# Perangkat inferensi SBV2: "auto", "cuda", atau "cpu"
SBV2_DEVICE=auto
# Izinkan fallback ke Edge-TTS saat SBV2 gagal nyata: 1=ya (default), 0=tidak pernah
SBV2_ALLOW_FALLBACK=1
# Batas waktu pengaman macet total: max(SBV2_TIMEOUT_S, chars * 0.5) detik
# Bukan alasan jatuh ke Edge karena lambat; hanya trigger error/peringatan
SBV2_TIMEOUT_S=30.0
# Panjang maksimum potongan teks per sintesis (karakter Jepang)
# Baris LLM dipecah di 。！？… lalu 、 sebelum disintesis — suara pertama lebih cepat
SBV2_MAX_CHARS=40

# --- Konfigurasi STT (Speech-to-Text) ---
# Model Whisper yang dipakai; diunduh otomatis pertama kali (beberapa ratus MB s.d. beberapa GB)
# Alternatif: large-v3 (paling akurat, ~3 GB), medium (~1.5 GB), small (~500 MB)
WHISPER_MODEL=turbo
# Compute type untuk GPU; gunakan float16 jika VRAM longgar (sedikit lebih cepat)
WHISPER_COMPUTE_TYPE=int8_float16

# --- Konfigurasi Pemutar Musik Spotify (Opsional) ---
# Dapatkan Client ID & Secret di https://developer.spotify.com/dashboard
# Redirect URI wajib didaftarkan di dashboard: http://localhost:8888/callback
# Catatan: Kontrol pemutaran Spotify Web API membutuhkan akun Spotify Premium.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback

# --- Push-to-Talk / Listen Mode ---
# LISTEN_MODE: 'toggle' (default) = satu klik = satu ucapan; VAD menentukan akhir ucapan;
#              'hold'             = tahan tombol = rekam; lepas = kirim ke STT
#              'always'          = perilaku lama (mic selalu mendengarkan)
LISTEN_MODE=toggle

# Waktu tunggu awal ucapan di mode toggle (detik); lewat batas ini kembali idle otomatis
LISTEN_TIMEOUT_S=8

# Hotkey keyboard untuk mulai/berhenti mendengarkan (default: Space)
# Contoh lain: F1, KeyQ, AltLeft (nama standar KeyboardEvent.code)
LISTEN_HOTKEY=Space

# MIC_KEEP_OPEN: 0 = tutup stream saat idle (indikator mic OS mati, lebih privat) [default]
#                1 = stream tetap terbuka, frame dibuang saat idle
#                    (kurangi latensi buka stream; indikator mic OS tetap menyala)
MIC_KEEP_OPEN=0

# LISTEN_AUTO_ARM_ON_CONFIRM: 1 = setelah agent meminta konfirmasi ("hapus file...?"),
#   otomatis mulai mendengarkan satu ucapan untuk jawaban ya/tidak [default]
#   0 = pengguna harus menekan tombol secara manual
LISTEN_AUTO_ARM_ON_CONFIRM=1
