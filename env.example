# Salin file ini menjadi ".env" lalu isi kuncinya. Jangan di-upload ke GitHub.

# --- Opsi 1: Groq (cepat, ada kuota gratis) ---
LLM_API_KEY=isi_api_key_anda
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Opsi 2: Gemini (endpoint OpenAI-compatible) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# --- Opsi 3: Ollama lokal ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

# Nama model sering berganti; cek daftar model terbaru di dashboard penyedia.
