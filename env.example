# Salin file ini menjadi ".env" lalu isi kuncinya. Jangan di-upload ke GitHub.

# --- Opsi 1: Groq (cepat, ada kuota gratis) ---
LLM_API_KEY=isi_api_key_anda
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Opsi 2: Gemini (endpoint OpenAI-compatible) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# --- Opsi 3: Ollama lokal ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

# --- Konfigurasi Modul Agent (Tool Calling) ---
# 1 = aktif (default), 0 = nonaktif
AGENT_ENABLED=1
# "keyword" = hemat biaya, hanya aktif saat ada kata kunci aksi (default)
# "always"  = agent selalu dipanggil di setiap giliran
AGENT_TRIGGER_MODE=keyword

# Nama model sering berganti; cek daftar model terbaru di dashboard penyedia.

# --- Konfigurasi TTS (Text-to-Speech) ---
# Backend TTS: "edge" (Edge-TTS bawaan), "sbv2" (Style-Bert-VITS2 lokal), atau "auto"
# Mode "sbv2"  = SBV2 selalu dipakai (default); tidak ada fallback ke Edge
# Mode "auto"  = SBV2 utama, fallback ke Edge hanya untuk kegagalan nyata (exception/OOM)
# Mode "edge"  = Edge-TTS saja
TTS_BACKEND=sbv2
# Perangkat inferensi SBV2: "auto", "cuda", atau "cpu"
SBV2_DEVICE=auto
# Izinkan fallback ke Edge-TTS saat SBV2 gagal nyata: 1=ya (default), 0=tidak pernah
SBV2_ALLOW_FALLBACK=1
# Batas waktu pengaman macet total: max(SBV2_TIMEOUT_S, chars * 0.5) detik
# Bukan alasan jatuh ke Edge karena lambat; hanya trigger error/peringatan
SBV2_TIMEOUT_S=30.0
# Panjang maksimum potongan teks per sintesis (karakter Jepang)
# Baris LLM dipecah di 。！？… lalu 、 sebelum disintesis — suara pertama lebih cepat
SBV2_MAX_CHARS=40

